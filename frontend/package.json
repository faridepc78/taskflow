{
  "name": "taskflow-ui",
  "version": "1.0.0",
  "private": true,
  "description": "Local, precompiled Tailwind styles for TaskFlow. No browser CDN required.",
  "scripts": {
    "build": "tailwindcss -i ./input.css -o ../static/css/app.css --minify",
    "watch": "tailwindcss -i ./input.css -o ../static/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.10",
    "tailwindcss": "4.1.10"
  }
}
